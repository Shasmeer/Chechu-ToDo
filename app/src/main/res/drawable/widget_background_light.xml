<?xml version="1.0" encoding="utf-8"?>
<!-- High-contrast light glass alternative for light wallpaper/theme. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#EAF7FAFF"
                android:centerColor="#E9F2F6FF" android:endColor="#E8DFEAFC" />
            <corners android:radius="30dp" />
            <stroke android:width="1dp" android:color="#EFFFFFFF" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient android:angle="90" android:startColor="#B5FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:radius="29dp" />
        </shape>
    </item>
</layer-list>

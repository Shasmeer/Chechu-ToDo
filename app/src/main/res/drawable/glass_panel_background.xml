<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#A12B4164"
                android:centerColor="#B11E2E4A" android:endColor="#C8172844" />
            <corners android:radius="32dp" />
            <stroke android:width="1dp" android:color="#6AFFFFFF" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient android:angle="90" android:startColor="#22FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:radius="31dp" />
        </shape>
    </item>
</layer-list>

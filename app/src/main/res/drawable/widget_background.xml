<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews-safe layered glass approximation. No wallpaper sampling/live blur. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#DB304869"
                android:centerColor="#D91B2C48" android:endColor="#E20D192F" />
            <corners android:radius="30dp" />
            <stroke android:width="1dp" android:color="#75FFFFFF" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient android:angle="90" android:startColor="#25FFFFFF"
                android:centerColor="#08FFFFFF" android:endColor="#00FFFFFF" />
            <corners android:radius="29dp" />
        </shape>
    </item>
</layer-list>

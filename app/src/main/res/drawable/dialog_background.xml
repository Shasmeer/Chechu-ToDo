<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#EE2C4164"
                android:centerColor="#F01A2B47" android:endColor="#F20E1C33" />
            <corners android:radius="30dp" />
            <stroke android:width="1dp" android:color="#8AFFFFFF" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient android:angle="90" android:startColor="#32FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:radius="29dp" />
        </shape>
    </item>
</layer-list>

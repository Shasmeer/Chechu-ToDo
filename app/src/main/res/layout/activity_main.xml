<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_ambient_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="26dp"
        android:paddingTop="54dp"
        android:paddingEnd="26dp"
        android:paddingBottom="36dp">

        <TextView
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:background="@drawable/glass_panel_background"
            android:contentDescription="Chechu ToDo"
            android:gravity="center"
            android:text="✦"
            android:textColor="@color/obsidian_text"
            android:textSize="37sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="-0.02"
            android:text="Chechu"
            android:textColor="@color/obsidian_text"
            android:textSize="42sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.12"
            android:text="YOUR DAY. BEAUTIFULLY IN VIEW."
            android:textColor="@color/obsidian_text_secondary"
            android:textSize="10sp" />

        <!-- Informational illustration only: real interactions happen in the widget. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="38dp"
            android:background="@drawable/glass_panel_background"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.12"
                android:text="WIDGET PREVIEW"
                android:textColor="@color/obsidian_accent"
                android:textSize="10sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-medium"
                android:text="Today's little wins"
                android:textColor="@color/obsidian_text"
                android:textSize="22sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="An example of your home-screen space"
                android:textColor="@color/obsidian_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="◯     Write down what matters"
                android:textColor="@color/obsidian_text"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="◯     Make room for good ideas"
                android:textColor="@color/obsidian_text"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="✓     A little progress counts"
                android:textColor="@color/obsidian_text_secondary"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:background="@drawable/input_background"
                android:gravity="center"
                android:padding="14dp"
                android:text="+   Add a thought"
                android:textColor="@color/obsidian_text"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="Long-press your home screen → Widgets → Chechu ToDo"
            android:textColor="@color/obsidian_text"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="Add the widget, then connect your Obsidian vault in its settings. No cloud account required."
            android:textColor="@color/obsidian_text_secondary"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="24dp"
    android:paddingBottom="18dp"
    android:background="@drawable/app_ambient_background">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Today"
        android:textColor="@color/obsidian_text"
        android:textSize="32sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif"/>

    <TextView
        android:id="@+id/home_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="Your tasks and notes, privately on this device"
        android:textColor="@color/obsidian_text_secondary"
        android:textSize="12sp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/today_segment_track"
        android:orientation="horizontal"
        android:padding="4dp">
        <Button
            android:id="@+id/home_tasks"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/today_segment_active"
            android:backgroundTint="@null"
            android:text="To-Do"
            android:textAllCaps="false"
            android:textColor="@color/obsidian_text"
            android:textSize="14sp"/>
        <Button
            android:id="@+id/home_notes"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/today_segment_inactive"
            android:backgroundTint="@null"
            android:text="Notes"
            android:textAllCaps="false"
            android:textColor="@color/obsidian_text_secondary"
            android:textSize="14sp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/home_section_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Active"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/obsidian_text"/>
        <Button
            android:id="@+id/home_folder"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/today_secondary_button"
            android:backgroundTint="@null"
            android:text="Active ▾"
            android:textAllCaps="false"
            android:textColor="@color/obsidian_text"
            android:textSize="12sp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">
        <LinearLayout
            android:id="@+id/home_items"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">
        <Button
            android:id="@+id/home_add_task"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/today_primary_button"
            android:backgroundTint="@null"
            android:text="+ To-Do"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="14sp"/>
        <Button
            android:id="@+id/home_add_note"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/today_secondary_button"
            android:backgroundTint="@null"
            android:text="+ Note"
            android:textAllCaps="false"
            android:textColor="@color/obsidian_text"
            android:textSize="14sp"/>
    </LinearLayout>
</LinearLayout>

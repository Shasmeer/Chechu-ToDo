<?xml version="1.0" encoding="utf-8"?>
<!-- The widget is fully opaque by default. All views are RemoteViews-compatible. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/widget_glass_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_background_light" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="15dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="11dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/widget_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Today"
                    android:textColor="#1F2024"
                    android:textSize="23sp"
                    android:fontFamily="sans-serif"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/widget_todo_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Stay organized"
                    android:textColor="#777982"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif"/>
            </LinearLayout>

            <ImageButton
                android:id="@+id/widget_cycle_note"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/today_header_action"
                android:contentDescription="Next pinned note"
                android:src="@drawable/ic_chevron_right"
                android:scaleType="centerInside"
                android:visibility="gone"/>

            <ImageButton
                android:id="@+id/widget_refresh"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/today_header_action"
                android:contentDescription="Refresh tasks"
                android:src="@android:drawable/stat_notify_sync"
                android:scaleType="centerInside"/>

            <ImageButton
                android:id="@+id/widget_settings"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/today_header_action"
                android:contentDescription="Widget settings"
                android:src="@android:drawable/ic_menu_manage"
                android:scaleType="centerInside"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/today_segment_track"
            android:orientation="horizontal"
            android:padding="4dp">
            <TextView
                android:id="@+id/widget_tab_todo"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/today_segment_active"
                android:gravity="center"
                android:contentDescription="Show to-do list"
                android:text="To-Do"
                android:textColor="#1F2024"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"/>
            <TextView
                android:id="@+id/widget_tab_notes"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/today_segment_inactive"
                android:gravity="center"
                android:contentDescription="Show notes"
                android:text="Notes"
                android:textColor="#777982"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"/>
        </LinearLayout>

        <TextView
            android:id="@+id/widget_note_preview"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/today_row"
            android:gravity="center"
            android:padding="16dp"
            android:text="No to-dos yet"
            android:textColor="#777982"
            android:textSize="14sp"
            android:maxLines="5"
            android:visibility="gone"/>

        <ListView
            android:id="@+id/widget_checklist"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="6dp"
            android:fadingEdge="none"
            android:scrollbars="none"
            android:paddingBottom="2dp" />

        <LinearLayout
            android:id="@+id/widget_button_bar"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <LinearLayout
                android:id="@+id/widget_add"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/today_primary_button"
                android:contentDescription="Add a to-do"
                android:gravity="center"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/widget_add_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_add_button"
                    android:contentDescription="@null"/>
                <TextView
                    android:id="@+id/widget_add_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="To-Do"
                    android:textColor="@android:color/white"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="13sp"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/widget_btn_capture"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/today_secondary_button"
                android:contentDescription="Add a note"
                android:gravity="center"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/widget_capture_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_note"
                    android:contentDescription="@null"/>
                <TextView
                    android:id="@+id/widget_capture_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Note"
                    android:textColor="#1F2024"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="13sp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
